# Kopieer naar .env (staat in .gitignore - NOOIT committen) en vul in.
# Op Vercel staan dezelfde variabelen onder Project → Settings → Environment Variables.

# --- Database (Supabase Postgres) -------------------------------------------------
# Supabase → Connect → "Transaction pooler" (poort 6543) voor Vercel/de app.
# Voor `npm run migrate` en het migratiescript mag ook de "Session pooler" (5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<wachtwoord>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Optioneel: volledige TLS-verificatie met het CA-certificaat uit Supabase
# (Project Settings → Database → SSL Configuration). Zonder: versleuteld, niet geverifieerd.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Alleen voor een lokale Postgres zonder TLS:
# DATABASE_SSL=false
# Optioneel: plan-quotum voor de capaciteitsprognose op Systeemstatus (bijv. 8 GB = 8589934592).
# SUPABASE_DB_MAX_BYTES=

# --- Supabase Auth + Storage -------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only! Nooit met NEXT_PUBLIC_-prefix, nooit in de browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optioneel (aanbevolen): voor de login- en wachtwoord-vergeten-aanroepen.
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_IMAGES_BUCKET=product-images
SUPABASE_STORAGE_DOCUMENTS_BUCKET=product-documents
# Lengte van de herstelcode in de "Reset Password"-mail (Supabase: Email OTP Length).
# SUPABASE_OTP_LENGTH=6
# Zet op true zodra er een eigen SMTP-server in Supabase staat (alleen voor de statuspagina).
# SUPABASE_SMTP_CONFIGURED=false

# --- Secrets -----------------------------------------------------------------------
# Lange willekeurige strings, bijv. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
COOKIE_SECRET=
# Vercel Cron stuurt deze mee als "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Basis-URL's ---------------------------------------------------------------------
# APP_BASE_URL: activatielinks. QR_BASE_URL: staat in elke geprinte QR-code - NOOIT wijzigen.
APP_BASE_URL=https://app.veripasso.com
QR_BASE_URL=https://qr.veripasso.com

# --- Alleen nodig voor eenmalige scripts (daarna weer verwijderen) -------------------
# scripts/seed-system-owner.js (Platform Owner, lokaal bcrypt-account / break-glass)
# SYSTEM_OWNER_EMAIL=
# SYSTEM_OWNER_PASSWORD=
# SYSTEM_OWNER_FIRST_NAME=
# SYSTEM_OWNER_LAST_NAME=

# scripts/migrate-from-azure.js (eenmalige migratie vanaf Azure)
# AZURE_SQL_SERVER=<server>.database.windows.net
# AZURE_SQL_DATABASE=
# AZURE_SQL_USER=
# AZURE_SQL_PASSWORD=
# AZURE_STORAGE_ACCOUNT_NAME=stveripassodev01   # + `az login`, of:
# AZURE_STORAGE_CONNECTION_STRING=

# scripts/e2e-supabase-live.js
# E2E_BASE_URL=https://app.veripasso.com
