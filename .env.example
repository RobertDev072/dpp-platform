# Voorbeeld van alle configuratie. Kopieer naar .env (alleen lokaal) en vul de waarden in.
# Bij hosting zet je dezelfde namen als (geheime) omgevingsvariabelen; nooit in dit bestand.

# --- Alleen lokaal -------------------------------------------------------------
# Zonder dit staat de sessie-cookie op secure=true en werkt inloggen niet over http.
# NOOIT in productie zetten.
NODE_ENV=development

# --- Database (PostgreSQL 17) ------------------------------------------------------
# Lokaal: `npm run db:local` start een eigen database op poort 5433. NOOIT productie.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/veripasso
# Alternatief voor DATABASE_URL: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD.
# Externe database met eigen CA-bundel: DATABASE_CA_CERT_FILE of DATABASE_CA_CERT.
# Optioneel: max. verbindingen per proces en querytimeout.
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT_MS=
# Maximale databasegrootte voor de capaciteitsmeter in het monitoringdashboard (bytes).
DATABASE_MAX_BYTES=

# --- Bestandsopslag (S3-compatibel, optioneel) ---------------------------------------
# Leeg = uploads van foto's en documenten staan uit; de rest van de app werkt gewoon.
# Werkt met elke S3-compatibele opslag, bijv. lokaal MinIO of later Cloudflare R2.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_IMAGES_BUCKET=
S3_DOCUMENTS_BUCKET=
# true voor MinIO
S3_FORCE_PATH_STYLE=

# --- Applicatie ------------------------------------------------------------------
# Lange random string, bijv.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Activatielinks. Leeg = het adres waarop de app geopend wordt.
APP_BASE_URL=http://localhost:3000
# Staat op elke gedrukte QR-code en is daarmee PERMANENT.
# Productie: https://qr.veripasso.com (nooit een tijdelijk adres).
QR_BASE_URL=http://localhost:3000

# Aantal proxy's/CDN's vóór de app (voor het echte bezoekers-IP). Lokaal: 1 of leeg.
TRUST_PROXY_HOPS=
# Server-side ophalen van paspoortdata via loopback, bijv. http://127.0.0.1:3000.
INTERNAL_API_ORIGIN=
# Publieke API: max. verzoeken per IP per minuut (standaard 300).
PUBLIC_RATE_LIMIT_PER_MINUTE=
# Achtergrondtaken (telemetrie, dagelijks onderhoud) uitzetten, bijv. voor scripts.
DISABLE_BACKGROUND_JOBS=
# json = gestructureerde logregels ook buiten productie.
LOG_FORMAT=

# --- Cloudflare vóór het QR-domein (optioneel, zie docs/cloudflare.md) -------------
# Gedeeld geheim met de Cloudflare Worker en de Transform Rule. Leeg = uit.
EDGE_SYNC_TOKEN=

# --- Alleen eenmalig voor `npm run seed:owner` (daarna weghalen) --------------
SYSTEM_OWNER_EMAIL=
SYSTEM_OWNER_PASSWORD=
SYSTEM_OWNER_FIRST_NAME=
SYSTEM_OWNER_LAST_NAME=
