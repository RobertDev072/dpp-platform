# Voorbeeld van alle configuratie. Kopieer naar .env (lokaal) en vul de waarden in.
# Op Vercel staan dezelfde namen onder Project → Settings → Environment Variables.
# Zie docs/infrastructuur.md voor wat waar hoort.

# --- Alleen lokaal -------------------------------------------------------------
# Zonder dit staat de sessie-cookie op secure=true en werkt inloggen niet over http.
# NOOIT op Vercel zetten.
NODE_ENV=development

# --- Database (Supabase Postgres) ---------------------------------------------
# Lokaal/scripts: Session pooler (poort 5432). Vercel: Transaction pooler (poort 6543).
# Speciale tekens in het wachtwoord URL-coderen (bijv. ? -> %3F).
DATABASE_URL=postgresql://postgres.<project-ref>:<wachtwoord>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
# Optioneel: CA-certificaat (Supabase → Database → SSL) voor volledige certificaatcontrole.
DATABASE_CA_CERT=
# Inbegrepen databasegrootte van het Supabase-plan (Free 500 MB, Pro 8 GB).
DATABASE_MAX_BYTES=524288000

# --- Bestandsopslag (Supabase Storage) ----------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Geheim: volledige toegang. Alleen server-side, nooit als NEXT_PUBLIC_-variabele.
SUPABASE_SERVICE_ROLE_KEY=
# Optioneel (standaard product-images / product-documents)
SUPABASE_STORAGE_IMAGES_BUCKET=
SUPABASE_STORAGE_DOCUMENTS_BUCKET=

# --- Applicatie ------------------------------------------------------------------
# Lange random strings, bijv.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Vercel Cron stuurt deze mee naar /api/cron/daily.
CRON_SECRET=

# Activatielinks. Leeg = het adres waarop de app geopend wordt.
APP_BASE_URL=http://localhost:3000
# Staat op elke gedrukte QR-code. Productie: https://qr.veripasso.com (nooit een *.vercel.app-adres).
QR_BASE_URL=http://localhost:3000

# --- Alleen tijdens de Entra-overgangsfase (anders leeg laten) ----------------
ENTRA_TENANT_NAME=
ENTRA_WEB_CLIENT_ID=

# --- Alleen eenmalig voor `npm run seed:owner` (daarna weghalen) --------------
SYSTEM_OWNER_EMAIL=
SYSTEM_OWNER_PASSWORD=
SYSTEM_OWNER_FIRST_NAME=
SYSTEM_OWNER_LAST_NAME=
