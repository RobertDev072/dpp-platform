# Voorbeeld van alle configuratie. Kopieer naar .env (alleen lokaal) en vul de waarden in.
# Op AWS zet de infrastructuurcode (infra/) dezelfde namen in de ECS-taakdefinitie;
# geheimen komen daar uit AWS Secrets Manager, nooit uit dit bestand.
# Zie README.md en docs/aws-deployment-runbook.md.

# --- Alleen lokaal -------------------------------------------------------------
# Zonder dit staat de sessie-cookie op secure=true en werkt inloggen niet over http.
# NOOIT op AWS zetten.
NODE_ENV=development

# --- Database (PostgreSQL 17) ------------------------------------------------------
# Lokaal: een eigen (test)database. NOOIT de productiedatabase.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veripasso
# Op AWS in plaats van DATABASE_URL (gezet door infra/):
#   DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_SECRET_ARN (wachtwoord uit Secrets Manager)
#   DATABASE_CA_CERT_FILE (RDS CA-bundel, in het Docker-image meegeleverd)
# Optioneel: max. verbindingen per proces en querytimeout.
DB_POOL_MAX=
DB_STATEMENT_TIMEOUT_MS=
# Maximale databasegrootte voor de capaciteitsmeter in het monitoringdashboard (bytes).
DATABASE_MAX_BYTES=

# --- Bestandsopslag (Amazon S3) -------------------------------------------------
# Lokaal: eigen test-buckets (met een AWS-profiel) of een S3-compatibele opslag
# (S3_ENDPOINT + S3_FORCE_PATH_STYLE=true, bijv. MinIO). Op AWS: rechten via de
# IAM-rol van de taak, dus GEEN toegangssleutels in env-vars.
AWS_REGION=eu-west-1
S3_IMAGES_BUCKET=
S3_DOCUMENTS_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=

# --- Applicatie ------------------------------------------------------------------
# Lange random string, bijv.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Activatielinks. Leeg = het adres waarop de app geopend wordt.
APP_BASE_URL=http://localhost:3000
# Staat op elke gedrukte QR-code en is daarmee PERMANENT.
# Productie: https://qr.veripasso.com (nooit een tijdelijk of AWS-adres).
QR_BASE_URL=http://localhost:3000

# Achter CloudFront + ALB: 2 (gezet door infra/). Lokaal: 1 of leeg.
TRUST_PROXY_HOPS=
# Server-side ophalen van paspoortdata via loopback (op AWS: http://127.0.0.1:3000).
INTERNAL_API_ORIGIN=
# Publieke API: max. verzoeken per IP per minuut (standaard 300).
PUBLIC_RATE_LIMIT_PER_MINUTE=
# Achtergrondtaken (telemetrie, dagelijks onderhoud) uitzetten, bijv. voor scripts.
DISABLE_BACKGROUND_JOBS=
# json = gestructureerde logregels ook buiten productie.
LOG_FORMAT=

# --- Alleen eenmalig voor `npm run seed:owner` (daarna weghalen) --------------
SYSTEM_OWNER_EMAIL=
SYSTEM_OWNER_PASSWORD=
SYSTEM_OWNER_FIRST_NAME=
SYSTEM_OWNER_LAST_NAME=
