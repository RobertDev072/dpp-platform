# Configuratie op de server. Kopieer naar deploy/.env (wordt nooit gecommit) en vul in.
#   cp deploy/.env.example deploy/.env && nano deploy/.env
# Lange willekeurige waarden maken: openssl rand -hex 32

# Start ook Caddy (HTTPS) mee met `docker compose up -d`.
COMPOSE_PROFILES=web

# --- Database (PostgreSQL in de container) ------------------------------------------
POSTGRES_PASSWORD=
# Maximale databasegrootte voor de capaciteitsmeter (bytes); 80 GB:
DATABASE_MAX_BYTES=85899345920

# --- Domeinen ------------------------------------------------------------------------
# Waar Caddy HTTPS-certificaten voor haalt (DNS moet al naar deze server wijzen).
DOMAINS=veripasso.com, www.veripasso.com, app.veripasso.com, qr.veripasso.com
ACME_EMAIL=
# Domeinverdeling in de app (landingspagina / app / QR).
SITE_DOMAINS=veripasso.com,www.veripasso.com
APP_DOMAIN=app.veripasso.com
QR_DOMAIN=qr.veripasso.com
APP_BASE_URL=https://app.veripasso.com
# Staat op elke gedrukte QR-code: NOOIT wijzigen.
QR_BASE_URL=https://qr.veripasso.com

# --- Geheimen --------------------------------------------------------------------------
COOKIE_SECRET=
MFA_ENCRYPTION_KEY=

# --- Bestandsopslag (Cloudflare R2, optioneel) -------------------------------------------
# Leeg = uploads van foto's en documenten staan uit. Zie docs/hosting-strato.md stap 6.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_IMAGES_BUCKET=
S3_DOCUMENTS_BUCKET=

# --- Cloudflare vóór qr.veripasso.com (optioneel, docs/cloudflare.md) -----------------
EDGE_SYNC_TOKEN=

# --- Eenmalig voor het aanmaken van de Platform Owner (daarna weghalen) ----------------
SYSTEM_OWNER_EMAIL=
SYSTEM_OWNER_PASSWORD=
SYSTEM_OWNER_FIRST_NAME=
SYSTEM_OWNER_LAST_NAME=
